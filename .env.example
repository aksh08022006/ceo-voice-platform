# Copy this file to .env for local development. Never commit real credentials.
CEO_VOICE_APPLICATION__SERVICE_NAME=ceo-voice-platform
CEO_VOICE_APPLICATION__ENVIRONMENT=development
CEO_VOICE_APPLICATION__DEBUG=false

CEO_VOICE_LOGGING__LEVEL=INFO
CEO_VOICE_LOGGING__FORMAT=console

# Browser API. Origins are exact; add deployed frontend origins explicitly in production.
CEO_VOICE_API__HOST=127.0.0.1
CEO_VOICE_API__PORT=8000
CEO_VOICE_API__ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
CEO_VOICE_API__SHOWCASE_ENABLED=true
# Set this to a validated catalog to serve immutable profiles instead of showcase fixtures.
# Published serving also requires the model settings below to be enabled and complete.
# CEO_VOICE_API__PUBLISHED_PROFILE_CATALOG=data/published/catalog.json

# Model access is disabled by default. Offline checks and the deterministic fixture demo do not
# require a credential. A production provider transport requires these externally managed values.
CEO_VOICE_MODEL__ENABLED=false
# CEO_VOICE_MODEL__PROVIDER=provider-name
# CEO_VOICE_MODEL__GENERATION_MODEL=model-name
# CEO_VOICE_MODEL__EMBEDDING_MODEL=embedding-model-name
# CEO_VOICE_MODEL__API_KEY=replace-through-a-secret-manager
# CEO_VOICE_MODEL__BASE_URL=https://api.openai.com/v1
CEO_VOICE_MODEL__CONTEXT_WINDOW_TOKENS=30000
CEO_VOICE_MODEL__MAXIMUM_OUTPUT_TOKENS=800
CEO_VOICE_MODEL__REQUEST_TIMEOUT_SECONDS=30
CEO_VOICE_MODEL__MAX_RETRIES=3
